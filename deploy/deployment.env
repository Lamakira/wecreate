# The facts about one deployment, in one place.
#
# Nothing secret lives here — every value is a hostname, a path or a port that
# is already public the moment the site answers a request. The secrets go in
# `/srv/wecreate/shared/env` on the server, written by hand once, and in the
# GitHub Environment the deploy workflow builds against. See README.md,
# "Deploying".
#
# Every script under `deploy/bin/` sources this file, and every one of them
# lets the environment win, so a second deployment is `SITE_HOST=… ./provision.sh`
# rather than a second copy of this file.

# The origin this deployment actually serves, without a scheme. It has to agree
# with NEXT_PUBLIC_SITE_URL in the build, because that variable is what every
# canonical URL and every emailed Order Access address carries — and unlike the
# rest of this file, that one is compiled into the bundle at build time and
# cannot be corrected on the server.
: "${SITE_HOST:=wecreate.weact.bj}"

# The unprivileged system account the Node process runs as. Owns nothing but
# its own release tree; has no login shell and no password.
: "${APP_USER:=wecreate}"

# Where releases, the `current` symlink and the shared environment file live.
: "${APP_ROOT:=/srv/wecreate}"

# Where provision.sh copies this directory to on the server, so that the weekly
# allowlist refresh has an absolute path that survives, and so that the script
# which undoes the deployment lives on the machine it undoes rather than only in
# somebody's checkout.
: "${SERVER_DEPLOY_DIR:=/opt/wecreate-deploy}"

# The loopback port `next start` listens on. Never exposed: nginx is the only
# thing that talks to it. 3000 is left alone so that a developer tunnelling in
# is not fighting the live process for a port.
: "${APP_PORT:=3001}"

# How many past releases stay on disk. Each is the standalone bundle plus the
# static assets, so a handful costs a few hundred megabytes on a 100 GB disk,
# and each one is a rollback that needs no network.
: "${KEEP_RELEASES:=5}"

# The sites already on this machine. Every script that changes shared state
# checks these before and after, and aborts on the step that broke one. They
# are the reason this deployment is allowed to exist here at all.
#
# Assigned with `=` rather than `:=`, so that `NEIGHBOURS=` explicitly empty is
# honoured — on a machine with nothing to protect there is nothing to check,
# and a default that reasserted itself would have the scripts curling somebody
# else's site from a host that has never heard of it.
: "${NEIGHBOURS=weact.bj askive.weact.bj}"

# Where certbot's HTTP-01 challenge files are written. A directory of its own,
# so the ACME dance never needs write access to anything either neighbour
# serves from.
: "${ACME_WEBROOT:=/var/www/${APP_USER}-acme}"

# The address certbot sends expiry warnings to. Deliberately empty here: this
# repository is public, and an operator's address is not the sort of thing to
# publish in it. Supply it at the moment of use —
# `ACME_EMAIL=you@example.com ./provision.sh` — and provision.sh refuses to
# issue a certificate without one, because the warning it sends sixty days from
# now is the only thing standing between a forgotten renewal and an expired
# certificate.
: "${ACME_EMAIL:=}"

# The request body ceiling nginx enforces, which has to agree with
# `serverActions.bodySizeLimit` in `next.config.ts` — both bound the whole
# multipart body rather than the file inside it, so both sit one megabyte above
# MAX_DELIVERABLE_BYTES (25 MB) in `src/commerce/paid-deliverables.ts`.
: "${MAX_BODY_SIZE:=26m}"
