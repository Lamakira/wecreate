# The runtime environment of one deployment.
#
# provision.sh copies this to /srv/wecreate/shared/env, root-owned and readable
# only by the wecreate group. Fill it in there, by hand, once. It is never in a
# release, so a rollback cannot bring a rotated credential back to life, and it
# is never in this repository, so nothing here is a secret.
#
# Read by systemd as an EnvironmentFile: `KEY=value`, one per line, no `export`,
# no shell expansion, no surrounding quotes unless the value really contains
# them. `systemctl restart wecreate` after an edit.
#
# ---------------------------------------------------------------------------
# What does NOT belong in this file
# ---------------------------------------------------------------------------
#
# Anything named NEXT_PUBLIC_*. Those are compiled into the bundle by
# `next build`, so setting them here does nothing at all — the value the browser
# and the server both see is whichever one CI built with. They live in the
# GitHub Environment the Deploy workflow reads, and the workflow is the only
# place they can be changed. That includes NEXT_PUBLIC_SITE_URL, which is the
# origin every canonical URL and every emailed Order Access address carries.
#
# Two variables are read in *both* places and have to agree, because
# `next.config.ts` reads them at build time to decide the Content-Security-Policy
# that lets a buyer's download redirect through: SUPABASE_URL and
# WECREATE_COMMERCE_PROVIDER. Change one here and not in CI and the next
# deployment serves a policy that blocks its own file handover.

# WECREATE_ALLOW_INDEXING is NOT here, despite having no NEXT_PUBLIC_ prefix.
# `/robots.txt` is prerendered, so `isIndexable()` runs once during the build
# and the answer is baked into a static file; setting it on this machine would
# do nothing at all. It lives in the GitHub Environment with the rest of the
# build-time values, unset everywhere but production.

# ---------------------------------------------------------------------------
# Managed Content
# ---------------------------------------------------------------------------

# Server-only. Grants read access to unpublished documents; preview needs it.
SANITY_API_READ_TOKEN=

# Who may open a preview session at /api/draft/enable, and who may drop the
# content cache through POST /api/revalidate. `openssl rand -hex 32` each, and
# a different pair per environment.
WECREATE_PREVIEW_SECRET=
WECREATE_REVALIDATE_SECRET=

# Configured on the Sanity webhook; the delivery signature is verified against
# the raw body.
SANITY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Commerce data plane
# ---------------------------------------------------------------------------
#
# The first two must match what CI built with — see the note at the top of this
# file.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# `supabase`, `fixture`, or empty. Empty means: Supabase when SUPABASE_URL is
# set, and no data plane at all otherwise. Read here at runtime *and* by
# next.config.ts at build time, so it is the second of the two that has to be
# the same in both places. Never `fixture` on a deployment: that provider ships
# published staff credentials for the acceptance suite.
WECREATE_COMMERCE_PROVIDER=

# Lets this deployment record a payment event, which is the only thing in the
# data plane that can approve an order. Its SHA-256 goes into
# commerce.payment_event_authorisation; see README.md, "Setting up Supabase".
WECREATE_PAYMENT_EVENT_SECRET=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
#
# Leave every one of these empty and the deployment simply has no payment
# provider: the site runs, the Boutique works, and the checkout says out loud
# that online payment is not open yet. That is the correct state for a staging
# deployment with no FedaPay account yet, and it fails loudly rather than
# quietly.
FEDAPAY_SECRET_KEY=

# `sandbox` or `live`. Staging is never anything but sandbox. Switching to live
# is the Commerce Launch Gate's own decision: this value *and*
# WECREATE_LIVE_PAYMENTS_APPROVED_BY, which names the owner who signed
# docs/commerce-launch-gate.md. Either one alone leaves the application in the
# sandbox. Nothing in a release sets them.
FEDAPAY_ENVIRONMENT=sandbox
WECREATE_LIVE_PAYMENTS_APPROVED_BY=

# Without this no payment is ever approved: the webhook handler verifies
# X-FEDAPAY-SIGNATURE against the raw body, and an unset secret verifies
# nothing, so every order stays pending. The safe failure, and the one to
# notice before going live.
FEDAPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Transactional email
# ---------------------------------------------------------------------------
#
# Unset means no email provider: an approved payment still grants Order Access,
# and the Fulfillment State says the delivery has to be taken up again, because
# a buyer who never received their link must be visible as one.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
#
# Unset means: Sentry when SENTRY_DSN is set, and nothing reported otherwise.
# Never `fixture` on a deployment.
WECREATE_MONITORING_PROVIDER=
SENTRY_DSN=

# How many days a buyer's contact is kept. Unset means nothing is forgotten.
# The privacy policy in force has to be an approved revision that names the
# same period; see README.md, "Personal-data retention".
WECREATE_PERSONAL_DATA_RETENTION_DAYS=
